# Frontend Environment Variables
# API base URL consumed by frontend app code
VITE_API_URL=/api

# Google Analytics Measurement ID (GA4)
# Example format: G-XXXXXXXXXX
VITE_GA_ID=G-XXXXXXXXXX

# Experiments feature flags
VITE_EXPERIMENTS_ENABLED=true
VITE_EXPERIMENTS_WEATHER_ENABLED=true
VITE_EXPERIMENTS_RATES_ENABLED=true
