# Backend service configuration.
# Copy to devops/env/backend.env for local Docker runs.

# Secret Options uses distinct non-cookie bearer credentials. Generate two
# independent high-entropy values of at least 32 characters; never expose either through a VITE_* build
# argument. The write credential may read, but the read credential may not
# mutate. Production refuses access if either value is missing or they match.
# SECRET_OPTIONS_READ_API_KEY=
# SECRET_OPTIONS_WRITE_API_KEY=
# SECRET_OPTIONS_READ_ACTOR=options-reader
# SECRET_OPTIONS_WRITE_ACTOR=options-operator

# Existing behavior keeps Yahoo as the default provider.
MARKET_DATA_PROVIDER=yahoo

# IBKR options-chain scanning:
# MARKET_DATA_PROVIDER=ibkr
# MARKET_DATA_FALLBACK_PROVIDER=yahoo
# IBKR_PROFILE=gateway-paper
# IBKR_EXCHANGE=SMART
# IBKR_CURRENCY=USD
# IBKR_TIMEOUT_SECONDS=10
# IBKR_ALLOW_DELAYED=true
# IBKR_CHAIN_CACHE_TTL_SECONDS=86400
# IBKR_QUOTE_CACHE_TTL_SECONDS=30
# IBKR_BARS_CACHE_TTL_SECONDS=300
# IBKR_MAX_STRIKES_PER_EXPIRY=40
# IBKR_SWEEP_PAUSE_SECONDS=0.25
# IBKR_TRANSIENT_RETRY_SECONDS=5
# IBKR_TRANSIENT_MAX_RETRIES=1

# Persistent raw capture of successful provider responses:
# MARKET_DATA_CAPTURE_ENABLED=true
# MARKET_DATA_CAPTURE_MAX_ROWS=2000
